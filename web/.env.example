# There are no secrets in the web app and there never will be: it reads the
# chain and hands you commands to run with your own key.
#
# The network and the contract address are NOT environment variables.  They
# live in exactly one file, `web/config/chain.json`, which the Python CLI reads
# too.  `scripts/deploy.py --write-config` is the only thing that writes it.
#
# This file is kept only for optional, non-chain settings.
NEXT_PUBLIC_ANALYTICS_ID=
