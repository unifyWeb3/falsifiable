# Public configuration only.  There are no secrets in the web app and there
# are never going to be: it reads the chain and it hands you commands to run.
#
# Copy to `.env.local` and adjust.

# The public GenLayer Studio JSON-RPC endpoint.
NEXT_PUBLIC_STUDIONET_RPC=https://studio.genlayer.com/api/rpc

# The deployed Falsifiable contract.
NEXT_PUBLIC_FALSIFIABLE_CONTRACT=0xdf426A429a9C9Ed25f2FF208aA81190dB3874822
